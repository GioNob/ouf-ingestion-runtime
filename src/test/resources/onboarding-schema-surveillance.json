{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/components/schemas/SchemaObservation"
    },
    {
      "$ref": "#/components/schemas/LegacySchemaReport"
    }
  ],
  "components": {
    "schemas": {
      "SchemaObservation": {
        "type": "object",
        "required": [
          "incidentKey",
          "state",
          "observationPolls",
          "observedAt"
        ],
        "properties": {
          "incidentKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "state": {
            "type": "string",
            "enum": [
              "OPEN",
              "UPDATE",
              "RESOLVED"
            ]
          },
          "expectedSchemaRef": {
            "type": "string",
            "minLength": 1
          },
          "observedSchema": {
            "type": "object",
            "required": [
              "schemaVersion",
              "fieldsSha256",
              "fields"
            ],
            "properties": {
              "schemaVersion": {
                "type": "string",
                "minLength": 1
              },
              "fieldsSha256": {
                "type": "string",
                "pattern": "^(sha256:)?[0-9a-f]{64}$"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type",
                    "nullable"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "nullable": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "differences": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "$ref": "#/components/schemas/SchemaDifference"
            }
          },
          "frozenCheckpointRef": {
            "type": "string",
            "minLength": 1
          },
          "observationPolls": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Cumulative producer counter"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "enum": [
              "SCHEMA_RETURNED",
              "REVISION_ACTIVATED"
            ],
            "description": "Defaults to SCHEMA_RETURNED on RESOLVED"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "OPEN"
                }
              }
            },
            "then": {
              "required": [
                "expectedSchemaRef",
                "observedSchema",
                "differences",
                "frozenCheckpointRef"
              ]
            }
          }
        ]
      },
      "SchemaDifference": {
        "type": "object",
        "required": [
          "field",
          "change"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "enum": [
              "ADDED",
              "REMOVED",
              "TYPE_CHANGED",
              "NULLABILITY_CHANGED",
              "KEY_CHANGED",
              "GEOMETRY_CHANGED"
            ]
          }
        }
      },
      "LegacySchemaReport": {
        "type": "object",
        "required": [
          "observedSchemaRef",
          "observedFingerprint",
          "classification"
        ],
        "properties": {
          "observedSchemaRef": {
            "type": "string"
          },
          "previousFingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedFingerprint": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "UNCHANGED",
              "ADDITIVE",
              "BREAKING",
              "UNKNOWN"
            ]
          },
          "detail": {
            "type": "object"
          }
        }
      }
    }
  }
}
