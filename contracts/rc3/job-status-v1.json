{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/common/job-status-v1.json",
  "title": "OUF Job Status v1",
  "type": "object",
  "required": [
    "jobId",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "jobId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "PAUSED",
        "RETRY_WAIT",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "nextRetryAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "resultRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "draft",
  "x-ouf-blueprint": "OUF System Integration & Development Blueprint v0.1",
  "x-ouf-note": "Core fields only. Field-level contract freeze required before promotion to v1.0."
}
